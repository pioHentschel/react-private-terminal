{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demoui-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "demoui-app",
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "stats-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "demoui-app",
